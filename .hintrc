{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "backdrop-filter",
          "user-select",
          "scrollbar-width",
          "scrollbar-width: none",
          "min-height: auto",
          "-webkit-mask",
          "scrollbar-color",
          "scrollbar-width: thin",
          "text-wrap",
          "text-wrap: balance",
          "border: 0.0625rem solid color-mix(in srgb, var(--success) 20%, transparent)",
          "border: 0.0625rem solid color-mix(in srgb, var(--success) 25%, transparent)"
        ]
      }
    ],
    "css-prefix-order": "off"
  }
}